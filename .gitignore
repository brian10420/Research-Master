# python
__pycache__/
*.pyc

# blind-review label mappings are written here by tools/anonymize.py and must
# never be committed or read by a reviewer role (SCIENTIFIC_RULES §7)
eval/.sealed/*
!eval/.sealed/README.md
!eval/.sealed/.gitkeep
.~lock.*#

# the operator's illustration originals (1254 px) and their archive stay outside
# version control; assets/roles/illustrations/ holds the committed 512 px renders
assets/roles/agent-illustrations-15/
assets/roles/agent-illustrations-15.zip
